# SÉRA BY SIMRAN — Admin Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.

APP_ENV=development
PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Supabase (Staff Auth & MFA Session Only — NO SERVICE ROLE KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API Communication (Data calls use staff Bearer token)
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional Services
SENTRY_DSN=
